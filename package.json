{
  "name": "agentroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/generate-client.mjs && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node scripts/generate-client.mjs",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "6.19.0",
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@prisma/internals": "^6.19.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "pg": "^8.23.1",
    "prisma": "6.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
