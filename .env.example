# Copy to .env. Generate distinct random AUTH_SECRET and EXECUTION_TOKEN values.
DATABASE_URL=postgresql://agentroom:change-me@127.0.0.1:5432/agentroom
POSTGRES_PASSWORD=change-me
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AGENTROOM_OWNER_GITHUB=
# Pin the owner's numeric GitHub ID too; usernames can change owners.
AGENTROOM_OWNER_GITHUB_ID=
EXECUTION_URL=http://127.0.0.1:8000
EXECUTION_TOKEN=
CLOUDROOM_URL=http://127.0.0.1:9840
CLOUDROOM_TOKEN=
# Same filesystem and paths visible to FastAPI and Core. Keep credentials elsewhere.
AGENTROOM_REPOSITORY=/code/fixture
AGENTROOM_WORKSPACES=/code
AGENTROOM_SNAPSHOTS=/var/lib/agentroom/snapshots
AGENTROOM_BASELINE=main
# Required for protected native deployment; leave [] only for local fixture checks.
AGENTROOM_WORKSPACE_COMMAND=[]
AGENTROOM_BACKUP_DESTINATION=
